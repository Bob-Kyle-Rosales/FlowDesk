# Database (local Docker)
DATABASE_URL=Host=localhost;Port=5433;Database=flowdesk;Username=flowdesk;Password=flowdesk

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_secret

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:3000

# Allowed Host header values — set to your Railway API domain in production
# e.g. AllowedHosts=flowdesk-api.railway.app
# (appsettings.json restricts to localhost; this env var overrides it on Railway)
AllowedHosts=localhost;localhost:5269

# AI report generation
AI_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# External services (fill in Phase 4+)
STRIPE_SECRET_KEY=
STRIPE_CLIENT_ID=      # Stripe Connect client ID — Dashboard → Connect → Settings (starts with ca_)
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=   # Verified sender address in your SendGrid account
SENDGRID_FROM_NAME=FlowDesk
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=   # e.g. https://pub-<hash>.r2.dev
